<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ generates the launch splash from the activity theme. Match
         Pondo's background and drop the launcher icon so the branded in-app
         loader is the first branded thing users see. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/statusBar</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/statusBar</item>
        <item name="android:statusBarColor">@color/statusBar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
