<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ always paints a system splash, so hide the app icon and let the
     background blend into the branded loader rendered by the WebView. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
